APP_ENV=development
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/life_coach
APP_OBJECT_STORE_ENDPOINT=http://localhost:9000
APP_OBJECT_STORE_BUCKET=life-coach-dev
# Source API remains disabled until auth, an HMAC key, and a content protector are configured.
APP_SOURCE_API_ENABLED=false
# APP_SOURCE_API_HMAC_KEY=at-least-32-bytes-of-random-secret-material
# Development/synthetic canary only; production must inject a managed protector adapter.
# APP_LOCAL_SOURCE_CONTENT_KEY=development-only-at-least-32-bytes
APP_MODEL_PROVIDER=disabled
# Required when APP_MODEL_PROVIDER is enabled; inject from a secret manager.
# APP_MODEL_RUN_HMAC_KEY=at-least-32-bytes-of-random-secret-material
# Runtime authentication (all-or-none; use HTTPS outside local test doubles)
# APP_AUTH_INTROSPECTION_URL=https://identity.example/oauth2/introspect
# APP_AUTH_ISSUER=https://identity.example
# APP_AUTH_AUDIENCE=life-coach-api
# APP_AUTH_CLIENT_ID=life-coach-backend
# APP_AUTH_CLIENT_SECRET=inject-from-secret-manager
# APP_AUTH_TIMEOUT_SECONDS=3
APP_LOG_LEVEL=INFO
